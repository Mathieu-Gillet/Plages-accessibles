# =============================================================
# PLAGES ACCESSIBLES — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# =============================================================
#
# Le contenu (fiches plages) vit dans content/plages/*.json, versionné dans Git.
# Seuls les VOTES des visiteurs nécessitent une base : une table Supabase.
# Sans elle, le site fonctionne — simplement sans note communautaire.
#

# ── URL publique du site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── GitHub PAT (formulaire de contribution → Pull Request) ──
# Requis pour /api/contribuer : chaque soumission crée une branche
# + une Pull Request, mergée automatiquement si la CI est verte.
# Créer un fine-grained PAT sur https://github.com/settings/tokens
# Scopes requis : Contents (read & write), Pull requests (read & write)
# Restreindre au seul dépôt Mathieu-Gillet/Plages-accessibles
GITHUB_PAT="ghp_..."

# ── Votes communautaires (Supabase) ───────────────────────────
# Les notes du site proviennent exclusivement des votes de visiteurs.
# Schéma à exécuter une fois : supabase/migrations/0001_votes_communautaires.sql
#
# Si ces trois variables sont absentes : les pages s'affichent normalement,
# sans note communautaire, et POST /api/vote répond 503. Le build ne casse pas.
#
# Project Settings → API dans le dashboard Supabase.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# service_role key : contourne RLS, accès SERVEUR UNIQUEMENT.
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais l'utiliser dans un composant client.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Sel des empreintes de votant et d'IP (aucune donnée personnelle stockée en clair).
# Générer avec : openssl rand -hex 32
# Attention : changer ce sel remet à zéro la déduplication des votes existants.
VOTE_SALT="remplacer-par-32-octets-aleatoires"

# ── Email (Resend) — OPTIONNEL ────────────────────────────────
# Notification à l'admin quand un commentaire de vote attend une modération.
# Si absent, le vote est enregistré quand même (seul l'email manque).
# Créer un compte sur https://resend.com et vérifier votre domaine
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="contributions@plages-accessibles.fr"
ADMIN_EMAIL="admin@plages-accessibles.fr"
